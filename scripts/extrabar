#!/usr/bin/env bash

set -u

command -v polybar >/dev/null 2>&1 || exit 0

pkill -u "$UID" -x polybar 2>/dev/null && sleep 0.2

config="$HOME/.config/suckless/dwm/.config/polybar/simple.ini"
use_custom_config=1

args=()
if [[ $use_custom_config -eq 1 && -f $config ]]; then
	args=(-c "$config")
fi

if command -v setsid >/dev/null 2>&1; then
	setsid -f polybar "${args[@]}" >/dev/null 2>&1
else
	polybar "${args[@]}" >/dev/null 2>&1 &
fi
