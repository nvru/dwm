[global]
    font = Monospace 10
    allow_markup = yes
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    transparency = 0
    idle_threshold = 120
    monitor = 0
    follow = mouse
    sticky_history = yes
    history_length = 20
    show_indicators = yes
    line_height = 0
    separator_height = 2
    padding = 8
    horizontal_padding = 8
    frame_width = 2
    frame_color = "#ffffffff"
    separator_color = frame

[urgency_low]
    background = "#2e3440"
    foreground = "#d8dee9"
    timeout = 5

[urgency_normal]
    background = "#000000"
    foreground = "#e5e9f0"
    timeout = 10

[urgency_critical]
    background = "#3b4252"
    foreground = "#eceff4"
    frame_color = "#bf616a"
    timeout = 0
